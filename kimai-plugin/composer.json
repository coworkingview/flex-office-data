{
    "name": "coworkingview/workplace",
    "description": "Tag Kimai timesheets and projects with a workplace and report hours by workplace.",
    "homepage": "https://coworkingview.com",
    "type": "kimai-plugin",
    "version": "0.1.0",
    "keywords": [
        "kimai",
        "kimai-plugin",
        "coworking"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "CoworkingView",
            "email": "info@coworkingview.com",
            "homepage": "https://coworkingview.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "KimaiPlugin\\CoworkingViewBundle\\": ""
        }
    },
    "extra": {
        "kimai": {
            "require": 26000,
            "name": "CoworkingView Workplace"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": false
        }
    },
    "scripts": {
        "lint": [
            "@php-syntax",
            "@structure"
        ],
        "php-syntax": "find CoworkingViewBundle.php DependencyInjection EventSubscriber Controller Form Model Reporting tests bin -name '*.php' -print0 | xargs -0 -n1 php -l",
        "structure": "@php bin/check-structure.php",
        "test": "@php vendor/bin/phpunit"
    }
}
