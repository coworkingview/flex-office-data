SELECT city_slug, city_name, country_code, currency, published,
       property_count, operator_count, entry_median, entry_min, entry_max,
       p25, p75, sample_size
FROM coworkingview_cities
ORDER BY published DESC, city_slug;
  city_slug   |  city_name   | country_code | currency | published | property_count | operator_count | entry_median | entry_min | entry_max | p25  | p75  | sample_size 
--------------+--------------+--------------+----------+-----------+----------------+----------------+--------------+-----------+-----------+------+------+-------------
 abu-dhabi    | Abu Dhabi    | AE           | AED      | t         |              2 |              1 |         1453 |      1069 |      7535 | 1400 | 2200 |           2
 berlin       | Berlin       | DE           | EUR      | t         |             85 |             48 |          265 |        80 |      2100 |  219 |  450 |          85
 madrid       | Madrid       | ES           | EUR      | t         |             10 |              6 |          325 |        85 |      1980 |  195 |  349 |          10
 example-town | Example Town |              |          | f         |                |                |              |           |           |      |      |            
(4 rows)

SELECT city_slug, product, median, license,
       attribution = (SELECT attribution FROM coworkingview_about) AS attribution_matches
FROM coworkingview_rates
WHERE city_slug = 'berlin' AND product = 'flex_desk';
 city_slug |  product  | median |  license  | attribution_matches 
-----------+-----------+--------+-----------+---------------------
 berlin    | flex_desk |    214 | CC-BY-4.0 | t
