# openSUSE Build Service: the crate and vendor.tar.zst are generated and
# committed to OBS, not to git (vendor.tar.zst is the whole crates.io graph).
integrations/obs/*.crate
integrations/obs/vendor.tar.zst
integrations/obs/vendor.tar
# Fedora COPR: same generated sources, built in CI and published as an SRPM.
integrations/copr/*.crate
integrations/copr/vendor.tar.zst
integrations/copr/vendor.tar
integrations/copr/copr-output/
# Java
integrations/java/target/
integrations/java/dist/
