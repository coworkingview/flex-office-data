{
    "name": "coworkingview/joomla-module-dev",
    "description": "Development checks for the CoworkingView Joomla module. This package is not installed on a site.",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "joomla/coding-standards": "3.0.0-alpha",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
