  <metadata>
    <id>cwv</id>
    <version>0.1.0</version>
    <title>cwv (CoworkingView CLI)</title>
    <authors>CoworkingView</authors>
    <owners>CoworkingView</owners>
    <projectUrl>https://github.com/coworkingview/flex-office-data</projectUrl>
    <projectSourceUrl>https://github.com/coworkingview/flex-office-data/tree/main/rust</projectSourceUrl>
    <docsUrl>https://github.com/coworkingview/flex-office-data/tree/main/rust#readme</docsUrl>
    <bugTrackerUrl>https://github.com/coworkingview/flex-office-data/issues</bugTrackerUrl>
