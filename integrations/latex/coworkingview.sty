\msg_new:nnnn {coworkingview} {missing-data}
  {File~'coworkingview-rates.csv'~was~not~found.}
  {Install~coworkingview-rates.csv~next~to~coworkingview.sty,~
   on~the~TeX~input~path.}
\msg_new:nnn {coworkingview} {bad-snapshot}
  {Invalid~snapshot:~#1.}
\msg_new:nnnn {coworkingview} {unknown-city}
  {Unknown~city~'#1'.~Available~cities:~#2.}
  {City~names~and~slugs~are~matched~without~regard~to~case.~
   Spaces,~hyphens~and~underscores~are~the~same~separator.~
   The~snapshot~has~no~price~row~for~'#1'.}
\msg_new:nnnn {coworkingview} {unknown-product}
  {Unknown~product~'#1'~for~#2.}
  {The~product~is~a~code~such~as~flex_desk,~or~the~same~words~
   with~spaces~or~hyphens.~The~default~is~flex_desk.}

