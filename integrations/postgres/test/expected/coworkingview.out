SELECT city_slug, product, unit, median, p25, p75, sample_size,
       property_count, operator_count, low_confidence
FROM coworkingview_price_index
ORDER BY city_slug,
    CASE product
        WHEN 'flex_desk' THEN 1
        WHEN 'fix_desk' THEN 2
        WHEN 'private_office' THEN 3
        WHEN 'exclusive_bereich' THEN 4
        WHEN 'day_pass' THEN 5
        WHEN 'meeting_room' THEN 6
        WHEN 'event_space' THEN 7
        WHEN 'virtual_office' THEN 8
        WHEN 'membership' THEN 9
        ELSE 10
    END,
    product;
 city_slug |    product     | unit  | median | p25  | p75  | sample_size | property_count | operator_count | low_confidence 
-----------+----------------+-------+--------+------+------+-------------+----------------+----------------+----------------
 abu-dhabi | flex_desk      | month |   1400 | 1400 | 1800 |           3 |              2 |              1 | t
 abu-dhabi | fix_desk       | month |   1800 | 1800 | 1800 |           2 |              2 |              1 | t
 abu-dhabi | private_office | month |   2057 | 1486 | 2629 |           2 |              2 |              1 | t
 berlin    | flex_desk      | month |    214 |  199 |  292 |          72 |             66 |             38 | f
 berlin    | fix_desk       | month |    310 |  290 |  421 |          60 |             56 |             37 | f
 berlin    | private_office | month |    480 |  399 |  550 |          59 |             38 |             20 | f
 berlin    | day_pass       | day   |     35 |      |      |          59 |             55 |             27 | f
 berlin    | meeting_room   | hour  |     32 |      |      |          79 |             51 |             25 | f
 madrid    | flex_desk      | month |    175 |  130 |  199 |          13 |              6 |              4 | f
