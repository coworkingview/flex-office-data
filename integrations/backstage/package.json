{
  "name": "@coworkingview/backstage-plugin-coworkingview",
  "version": "0.1.0",
  "description": "Backstage frontend plugin for CoworkingView flexible workspace prices and spaces.",
  "license": "Apache-2.0",
  "author": "CoworkingView (https://coworkingview.com)",
  "homepage": "https://coworkingview.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coworkingview/flex-office-data.git",
    "directory": "integrations/backstage"
  },
  "bugs": {
    "url": "https://github.com/coworkingview/flex-office-data/issues"
  },
  "keywords": [
    "backstage",
    "coworking",
    "price-index"
  ],
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "coworkingview",
    "pluginPackages": [
      "@coworkingview/backstage-plugin-coworkingview"
    ]
  },
  "configSchema": "config.d.ts",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist",
    "config.d.ts",
    "CHANGELOG.md",
    "docs/screenshot.png"
  ],
  "scripts": {
    "start": "backstage-cli package start",
    "build": "npm run tsc && backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --watchAll=false",
    "tsc": "tsc --pretty false",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "peerDependencies": {
    "@backstage/core-components": "^0.18.0",
    "@backstage/core-plugin-api": "^1.12.0",
    "@backstage/frontend-plugin-api": "^0.18.0",
    "@backstage/theme": "^0.7.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "peerDependenciesMeta": {
    "@backstage/frontend-plugin-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@backstage/cli": "0.36.7",
    "@backstage/cli-defaults": "0.1.7",
    "@backstage/config": "1.3.10",
    "@backstage/core-components": "0.18.15",
    "@backstage/core-plugin-api": "1.12.11",
    "@backstage/frontend-dev-utils": "0.1.7",
    "@backstage/frontend-plugin-api": "0.18.2",
    "@backstage/test-utils": "1.7.23",
    "@backstage/theme": "0.7.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^30.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jsdom": "^27.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2"
  },
  "engines": {
    "node": ">=20"
  }
}
