CREATE SCHEMA cvtest;
ALTER EXTENSION coworkingview SET SCHEMA cvtest;
SELECT cvtest.coworkingview_rate('berlin');
 coworkingview_rate 
--------------------
                214
(1 row)

SELECT cvtest.coworkingview_rate('madrid', 'meeting_room');
 coworkingview_rate 
--------------------
