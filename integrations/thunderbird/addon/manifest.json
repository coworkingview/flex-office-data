{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.1.0",
  "author": "CoworkingView",
  "homepage_url": "https://coworkingview.com",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "coworkingview@coworkingview.com",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.coworkingview.com/*"],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "message_display_action": {
    "default_title": "__MSG_buttonLabel__",
    "default_label": "__MSG_buttonLabel__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "compose_action": {
    "default_title": "__MSG_buttonLabel__",
    "default_label": "__MSG_buttonLabel__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
