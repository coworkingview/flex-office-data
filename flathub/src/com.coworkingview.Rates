#!/usr/bin/env python3
"""Launcher installed as the Flatpak command."""

import os
import sys

SHARE = os.path.abspath(
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "share", "com.coworkingview.Rates")
)
sys.path.insert(0, SHARE)

from coworkingview_rates.app import main

if __name__ == "__main__":
    raise SystemExit(main())
